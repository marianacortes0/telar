---
import RamaLayout from '../layouts/RamaLayout.astro';
import NivelesRama from '../components/ui/NivelesRama.astro';
import { MONITOR, desdeMinimo, formatoCOP } from '../lib/precios';
import { MENSAJES } from '../lib/whatsapp';

const desde = desdeMinimo(MONITOR);

const casos = [
  {
    titulo: 'En una cocina',
    texto:
      'El tablero muestra a qué hora se dispara el consumo y qué equipo lo causa. La factura deja de ser una sorpresa.',
  },
  {
    titulo: 'Con paneles solares',
    texto:
      'Usted ve cuánto producen frente a lo que consume, día a día, y sabe si rinden lo que deberían.',
  },
  {
    titulo: 'Con varias sedes',
    texto: 'El consumo de todas las sedes en un solo tablero, para comparar y decidir con números.',
  },
];

const faq = [
  {
    id: 'hardware',
    pregunta: '¿Necesito comprar algo?',
    respuesta:
      'Sí: los medidores o sensores compatibles con lo que quiera medir. Le pasamos la lista de compras y el tablero lo montamos nosotros.',
  },
  {
    id: 'compatible',
    pregunta: '¿Sirve con mi inversor o mi medidor?',
    respuesta:
      'Funciona con la mayoría de inversores y medidores del mercado. Antes de cotizar confirmamos que su equipo sea compatible.',
  },
  {
    id: 'celular',
    pregunta: '¿Puedo verlo desde el celular?',
    respuesta: 'Sí. El tablero se abre desde cualquier navegador, en el celular o en el computador.',
  },
];
---

<RamaLayout
  titulo="Telar Monitor: tableros de consumo y ventas"
  descripcion={`Su consumo de energía en tiempo real y, si lo desea, sus ventas e indicadores en el mismo tablero. Desde ${formatoCOP(desde)}, IVA incluido.`}
  rama="Telar Monitor"
  capa="datos"
  heroTitulo="Su consumo en tiempo real: así empieza una ciudad que ahorra"
  heroSub="Un tablero con su consumo de energía al minuto y, desde el nivel Conectado, sus ventas e indicadores. Deje de adivinar a dónde se va la plata."
  desde={desde}
  waMensaje={MENSAJES.monitor}
  problema={{
    titulo: 'No se puede mejorar lo que no se mide',
    parrafos: [
      'La factura de la luz sube y usted no sabe qué la dispara. Tiene paneles solares y no sabe si rinden. Las ventas del mes se ven cuando el mes ya pasó.',
      'Telar Monitor lleva esos datos a un tablero claro y en tiempo real. <em>Los números dejan de ser una sorpresa a fin de mes.</em>',
    ],
  }}
  casos={casos}
  faq={faq}
  cierreTitulo="¿Qué quiere empezar a medir?"
>
  <NivelesRama rama="Telar Monitor" linea={MONITOR} />
</RamaLayout>
