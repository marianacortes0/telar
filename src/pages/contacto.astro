---
import Base from '../layouts/Base.astro';
import TejidoHero from '../components/trama/TejidoHero.astro';
import Aviso from '../components/ui/Aviso.astro';
import { Icon } from 'astro-icon/components';
import { NEGOCIO } from '../lib/constantes';
import { linkWhatsApp, MENSAJES } from '../lib/whatsapp';

const opciones = [
  { titulo: 'Consulta general', texto: 'No sabe por dónde empezar. Nosotros lo orientamos.', mensaje: MENSAJES.general },
  { titulo: 'Tarjetas y productos NFC', texto: 'Tarjetas, menús, merchandising, packaging o tags de rutinas.', mensaje: MENSAJES.tarjetas },
  { titulo: 'Desarrollo web', texto: 'Landing, sitio corporativo, panel o tienda en línea.', mensaje: MENSAJES.web },
  { titulo: 'Automatización e IA (empresas)', texto: 'Agentes de IA, flujos con n8n/Make, dashboards, equipos u oficinas.', mensaje: MENSAJES.flow },
  { titulo: 'Domótica (Telar Casa)', texto: 'Automatización con Home Assistant para casa u oficina.', mensaje: MENSAJES.domoticaGeneral },
];

const waGeneral = linkWhatsApp(MENSAJES.general);
---

<Base
  titulo="Contacto"
  descripcion="Escríbanos por WhatsApp. Elija el tema y le llega un mensaje listo para enviar. Bogotá, Colombia. Remoto en todo el país y presencial en Bogotá."
>
  <TejidoHero
    eyebrow="Contacto"
    titulo="Hablemos"
    subtitulo="No usamos formularios: escríbanos directo por WhatsApp. Elija el tema y le abrimos un mensaje listo para enviar."
  >
    <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn-oro">Escribir ahora</a>
  </TejidoHero>

  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">¿Sobre qué?</p>
        <h2>Elija el tema</h2>
      </header>

      <div class="opciones">
        {
          opciones.map((o, i) => (
            <a
              class="card opcion"
              href={linkWhatsApp(o.mensaje)}
              target="_blank"
              rel="noopener noreferrer"
              data-revelar
              style={`--i:${i}`}
            >
              <Icon name="lucide:message-circle" class="icono" aria-hidden="true" />
              <h3>{o.titulo}</h3>
              <p>{o.texto}</p>
              <span class="flecha" aria-hidden="true">WhatsApp →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor bloque-estrecho">
      <div class="datos card" data-revelar>
        <h2>Datos de contacto</h2>
        <ul>
          <li><Icon name="lucide:phone" class="dato-icono" aria-hidden="true" /> {NEGOCIO.telefonoVisible}</li>
          <li><Icon name="lucide:mail" class="dato-icono" aria-hidden="true" /> {NEGOCIO.email}</li>
          <li><Icon name="lucide:map-pin" class="dato-icono" aria-hidden="true" /> {NEGOCIO.ciudad}, {NEGOCIO.pais} · remoto en todo el país, presencial en Bogotá</li>
        </ul>
      </div>

      <div class="tras-tabla" data-revelar>
        <Aviso variante="dato" titulo="Sin formularios, sin datos guardados">
          <p>Preferimos WhatsApp: es directo, queda registro para ambos y no almacenamos datos personales suyos en el sitio.</p>
        </Aviso>
      </div>
    </div>
  </section>
</Base>

<style>
  .opciones {
    display: grid;
    gap: 1rem;
  }
  .opcion {
    padding: 1.5rem;
    text-decoration: none;
    color: var(--color-lino);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color var(--dur-rapido) var(--ease-precision),
      transform var(--dur-rapido) var(--ease-salida);
  }
  .opcion:hover {
    border-color: var(--color-teal-luz);
    transform: translateY(-3px);
  }
  .opcion .icono {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-teal-luz);
  }
  .opcion h3 {
    font-family: var(--fuente-display);
    font-size: 1.2rem;
    margin: 0.25rem 0 0;
  }
  .opcion p {
    color: var(--color-humo);
    margin: 0;
    flex-grow: 1;
    line-height: 1.6;
  }
  .opcion .flecha {
    color: var(--color-oro);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .datos {
    padding: 1.75rem;
  }
  .datos h2 {
    font-size: 1.4rem;
    margin: 0 0 1rem;
  }
  .datos ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .datos li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-lino);
  }
  .dato-icono {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-oro);
    flex-shrink: 0;
  }

  @media (min-width: 48rem) {
    .opciones {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
