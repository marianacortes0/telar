---
import Base from '../layouts/Base.astro';
import TejidoHero from '../components/trama/TejidoHero.astro';
import Aviso from '../components/ui/Aviso.astro';
import { linkWhatsApp, MENSAJES } from '../lib/whatsapp';

// Honestidad ante todo (§6.1): mientras no haya casos de clientes con
// autorización escrita, mostramos proyectos propios y piloto, sin cifras inventadas.
const casos = [
  {
    etiqueta: 'Telar Web',
    titulo: 'Este mismo sitio',
    texto:
      'telar.co está hecho con Astro, Preact y Tailwind. HTML estático, casi cero JavaScript, animaciones respetuosas del movimiento reducido y navegación por teclado. Es nuestra propia carta de presentación técnica.',
    stack: 'Astro · Preact · Tailwind v4',
  },
  {
    etiqueta: 'Telar Casa',
    titulo: 'Casa piloto — Home Assistant',
    texto:
      'Nuestra propia instalación de domótica sobre Raspberry Pi: luces por presencia, alertas con foto al detectar movimiento y escenas de “salgo de casa”. La usamos para probar cada integración antes de proponerla.',
    stack: 'Home Assistant · Raspberry Pi · Nabu Casa',
  },
  {
    etiqueta: 'Telar Tag',
    titulo: 'Tarjetas NFC del equipo',
    texto:
      'Nuestras propias tarjetas en PVC negro mate, con perfil digital y QR de respaldo. Probadas en Android e iOS. El mejor demo es entregarle una en la mano.',
    stack: 'NFC · PVC · Perfil digital',
  },
];

const wa = linkWhatsApp(MENSAJES.general);
---

<Base
  titulo="Portafolio"
  descripcion="Proyectos propios y piloto de Telar: este sitio, nuestra casa automatizada con Home Assistant y las tarjetas NFC del equipo."
>
  <TejidoHero
    eyebrow="Portafolio"
    titulo="Nuestro trabajo"
    subtitulo="Estamos arrancando: por ahora, proyectos propios y piloto. Sin clientes inventados ni cifras infladas."
  >
    <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-oro">Cuéntenos su proyecto</a>
  </TejidoHero>

  <section class="seccion">
    <div class="contenedor">
      <div class="casos">
        {
          casos.map((c, i) => (
            <article class="card caso" data-revelar style={`--i:${i}`}>
              <span class="etiqueta mono">{c.etiqueta}</span>
              <h2>{c.titulo}</h2>
              <p>{c.texto}</p>
              <span class="stack mono">{c.stack}</span>
            </article>
          ))
        }
      </div>

      <div class="tras-tabla" data-revelar>
        <Aviso variante="dato" titulo="Sobre este portafolio">
          <p>
            Preferimos ser honestos: aún no publicamos casos de clientes porque cada uno requiere su
            autorización escrita. En cuanto los primeros nos la den, entran aquí con nombre y
            resultados reales.
          </p>
        </Aviso>
      </div>
    </div>
  </section>

  <section class="seccion cierre">
    <div class="contenedor bloque-estrecho centrado" data-revelar>
      <h2>¿Quiere ser de los primeros?</h2>
      <p class="intro">Precios de arranque a cambio de un testimonio honesto al terminar.</p>
      <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-oro">Escribir por WhatsApp</a>
    </div>
  </section>
</Base>

<style>
  .casos {
    display: grid;
    gap: 1.25rem;
  }
  .caso {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .etiqueta {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-teal-luz);
  }
  .caso h2 {
    font-family: var(--fuente-display);
    font-size: 1.4rem;
    margin: 0;
  }
  .caso p {
    color: var(--color-humo);
    line-height: 1.7;
    margin: 0;
    flex-grow: 1;
  }
  .caso .stack {
    font-size: 0.8rem;
    color: var(--color-humo);
    margin-top: 0.5rem;
  }
  @media (min-width: 64rem) {
    .casos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
