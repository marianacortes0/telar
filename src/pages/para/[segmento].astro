---
import Base from '../../layouts/Base.astro';
import TejidoHero from '../../components/trama/TejidoHero.astro';
import { linkWhatsApp, MENSAJES } from '../../lib/whatsapp';

export function getStaticPaths() {
  const segmentos = {
    profesionales: {
      titulo: 'Para profesionales',
      descripcion:
        'Tarjeta NFC con perfil digital y portafolio web para abogados, médicos, arquitectos, contadores y agentes. Desde $85.000.',
      eyebrow: 'Profesionales',
      heroTitulo: 'Su tarjeta de papel termina en la basura',
      heroSub:
        'El 88% de las tarjetas impresas se botan en una semana. Una tarjeta NFC no: la persona acerca el celular, guarda sus datos y lo tiene para siempre.',
      wa: MENSAJES.tarjetas,
      precioNota: 'Tarjeta con perfil desde $85.000 · Portafolio web desde $1.200.000',
      problemaTitulo: 'Reparte papel que nadie guarda',
      problema: [
        'Cada tarjeta impresa cuesta y casi todas terminan en la basura en una semana. Y cuando alguien quiere contactarlo, tiene que escribir su número a mano.',
        'Con una tarjeta NFC, la persona acerca el celular y guarda sus datos, sus redes y su portafolio de una. Si cambia de número o de cargo, edita el perfil sin reimprimir nada.',
      ],
      ofrecemos: [
        { titulo: 'Tarjeta NFC con perfil digital', texto: 'Datos, redes, portafolio y pago, de un toque.', href: '/servicios/tarjetas-nfc' },
        { titulo: 'Portafolio web profesional', texto: 'El sitio que lleva posponiendo, hecho para posicionar.', href: '/servicios/desarrollo-web' },
      ],
      objecion: {
        pregunta: '¿Se ve serio?',
        respuesta:
          'Sí. La versión premium va en PVC negro mate o metalizado, con diseño exclusivo y QR de respaldo. Se ve —y se siente— como una tarjeta de gama alta, no como un gadget.',
      },
    },
    empresas: {
      titulo: 'Para empresas',
      descripcion:
        'Sitio corporativo, tienda en línea, panel de administración, automatización con IA y oficina inteligente para pymes, tiendas y restaurantes. Desde $250.000.',
      eyebrow: 'Empresas',
      heroTitulo: 'Su negocio funcionando, no solo su página',
      heroSub:
        'Sitio web, tienda en línea y un panel donde administra productos, pedidos y clientes sin depender de nadie. Y si quiere, la carta digital de sus mesas y la oficina automatizada.',
      wa: MENSAJES.web,
      precioNota: 'Sitio corporativo desde $1.900.000 · Panel desde $3.500.000',
      problemaTitulo: 'Una página bonita no administra su negocio',
      problema: [
        'Muchos negocios tienen una página que solo se ve bien. Los pedidos siguen por un WhatsApp desordenado, el inventario en un cuaderno y los precios desactualizados.',
        'Construimos el sistema completo: el sitio, la tienda y el panel para que administre todo usted mismo, más los menús NFC de sus mesas y la oficina automatizada si la quiere.',
      ],
      ofrecemos: [
        { titulo: 'Sitio corporativo y tienda en línea', texto: 'Con pasarela de pagos, inventario y notificaciones.', href: '/servicios/desarrollo-web' },
        { titulo: 'Automatización e IA', texto: 'Agentes de IA, flujos con n8n/Make y dashboards que corren solos.', href: '/#empresas' },
        { titulo: 'Menús digitales para sus mesas', texto: 'Carta, WiFi sin contraseña y reseñas en Google, de un toque.', href: '/servicios/menus-restaurantes' },
        { titulo: 'Oficina inteligente', texto: 'Accesos NFC, luces, clima y salas con Telar Office.', href: '/servicios/telar-office' },
      ],
      objecion: {
        pregunta: '¿Voy a poder manejarlo yo?',
        respuesta:
          'Sí. Le entregamos el panel con una sesión de una hora y documentación básica. Si algo se complica, están los planes de mantenimiento; pero el día a día lo maneja usted sin depender de nadie.',
      },
    },
    creadores: {
      titulo: 'Para creadores',
      descripcion:
        'Merchandising NFC y portafolio web para artistas, músicos, fotógrafos y tatuadores. Llaveros y pulseras que abren sus redes. Desde $30.000.',
      eyebrow: 'Creadores',
      heroTitulo: 'Un toque y están en su perfil',
      heroSub:
        'Llaveros, pulseras y pines que abren su Instagram, su TikTok o su tienda. Para vender en ferias, conciertos y mercados sin dictar su usuario en voz alta.',
      wa: MENSAJES.merchandising,
      precioNota: 'Merchandising NFC desde $30.000 · Portafolio web desde $1.200.000',
      problemaTitulo: 'Dictar su usuario letra por letra no escala',
      problema: [
        'En una feria o un concierto, cada persona que lo descubre tiene que sacar el celular, abrir Instagram y escribir bien su usuario. La mitad se rinde a mitad de camino.',
        'Con un llavero o una pulsera NFC, acercan el celular y ya están en su perfil. Y puede venderlos a sus propios seguidores: ahí hay un negocio por volumen.',
      ],
      ofrecemos: [
        { titulo: 'Merchandising NFC', texto: 'Llaveros, pulseras y pines que abren sus redes o su tienda.', href: '/servicios/merchandising' },
        { titulo: 'Portafolio web', texto: 'Un sitio para mostrar su trabajo y que lo encuentren en Google.', href: '/servicios/desarrollo-web' },
      ],
      objecion: {
        pregunta: '¿Lo puedo vender a mis seguidores?',
        respuesta:
          'Sí, y ahí está el negocio por volumen: le cotizamos lotes desde 20 unidades a mejor precio, con su marca, para que los revenda en sus ferias y conciertos.',
      },
    },
    'tu-casa': {
      titulo: 'Para su casa',
      descripcion:
        'Domótica con Home Assistant y tags de rutinas para su hogar o su Airbnb. Remoto o presencial. Desde $70.000.',
      eyebrow: 'Su casa',
      heroTitulo: 'Que su casa haga cosas sola',
      heroSub:
        'Automatización con Home Assistant: luces que se apagan cuando sale, alertas cuando alguien llega, escenas para su Airbnb. Lo configuramos remoto o presencial y le queda listo.',
      wa: MENSAJES.domoticaGeneral,
      precioNota: 'Tags desde $70.000 · Domótica desde $1.200.000',
      problemaTitulo: 'Escenas de la vida diaria, no un catálogo técnico',
      problema: [
        'No necesita saber de domótica para quererla. Que las luces se apaguen solas al salir. Que el Airbnb salude al huésped y ajuste la temperatura antes de que llegue. Que a las 10 p.m. la casa entre en modo noche con un toque.',
        'Eso es lo que montamos con Home Assistant. Aquí van las escenas del día a día; la especificación técnica completa —niveles, precios y qué incluye— está en la página de domótica.',
      ],
      ofrecemos: [
        { titulo: 'Domótica con Home Assistant', texto: 'Luces, sensores, cámaras y rutinas, remoto o presencial.', href: '/servicios/domotica' },
        { titulo: 'Tags de rutinas', texto: 'Stickers que ponen su celular en modo noche, silencio o foco.', href: '/servicios/tags-rutinas' },
      ],
      objecion: {
        pregunta: '¿Remoto o presencial?',
        respuesta:
          'Como prefiera, hacemos las dos. En remoto le mandamos una lista de compras, recibe una Raspberry Pi ya configurada y la enchufa al router; presencial, vamos y lo dejamos funcionando. El cableado y el montaje físico los hace su electricista.',
      },
    },
  } as const;

  return Object.entries(segmentos).map(([segmento, datos]) => ({
    params: { segmento },
    props: { datos },
  }));
}

const { datos } = Astro.props;
const wa = linkWhatsApp(datos.wa);
---

<Base titulo={datos.titulo} descripcion={datos.descripcion} waMensaje={datos.wa}>
  <TejidoHero eyebrow={datos.eyebrow} titulo={datos.heroTitulo} subtitulo={datos.heroSub}>
    <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-oro">Hablemos por WhatsApp</a>
    <span class="hero-nota mono">{datos.precioNota}</span>
  </TejidoHero>

  <section class="seccion">
    <div class="contenedor bloque-lectura">
      <p class="eyebrow" data-revelar>El problema</p>
      <h2 data-revelar style="--i:1">{datos.problemaTitulo}</h2>
      {datos.problema.map((p, i) => <p data-revelar style={`--i:${i + 2}`}>{p}</p>)}
    </div>
  </section>

  <section class="seccion banda">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Qué le ofrecemos</p>
        <h2>Lo que encaja con usted</h2>
      </header>
      <div class="ofrecemos">
        {
          datos.ofrecemos.map((o, i) => (
            <a class="card oferta" href={o.href} data-revelar style={`--i:${i}`}>
              <h3>{o.titulo}</h3>
              <p>{o.texto}</p>
              <span class="flecha" aria-hidden="true">Ver →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor bloque-estrecho">
      <div class="objecion card" data-revelar>
        <h2>{datos.objecion.pregunta}</h2>
        <p>{datos.objecion.respuesta}</p>
      </div>
    </div>
  </section>

  <section class="seccion cierre">
    <div class="contenedor bloque-estrecho centrado" data-revelar>
      <h2>¿Empezamos?</h2>
      <p class="intro">Cuéntenos su caso. La primera conversación no cuesta nada.</p>
      <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-oro">Escribir por WhatsApp</a>
    </div>
  </section>
</Base>

<style>
  .bloque-lectura h2 {
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    margin: 0.5rem 0 1.25rem;
  }
  .bloque-lectura p {
    color: var(--color-humo);
    line-height: 1.8;
    margin: 0 0 1rem;
  }

  .ofrecemos {
    display: grid;
    gap: 1rem;
  }
  .oferta {
    padding: 1.5rem;
    text-decoration: none;
    color: var(--color-lino);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color var(--dur-rapido) var(--ease-precision),
      transform var(--dur-rapido) var(--ease-salida);
  }
  .oferta:hover {
    border-color: var(--color-teal-luz);
    transform: translateY(-3px);
  }
  .oferta h3 {
    font-family: var(--fuente-display);
    font-size: 1.2rem;
    margin: 0;
  }
  .oferta p {
    color: var(--color-humo);
    margin: 0;
    flex-grow: 1;
    line-height: 1.6;
  }
  .oferta .flecha {
    color: var(--color-oro);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .objecion {
    padding: 1.75rem;
  }
  .objecion h2 {
    font-size: 1.4rem;
    margin: 0 0 0.75rem;
  }
  .objecion p {
    margin: 0;
    color: var(--color-humo);
    line-height: 1.75;
  }

  @media (min-width: 48rem) {
    .ofrecemos {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }
</style>
