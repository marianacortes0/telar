---
import ServicioSimple from '../layouts/ServicioSimple.astro';
import Aviso from '../components/ui/Aviso.astro';
import FAQ from '../components/islas/FAQ.tsx';
import { MENSAJES } from '../lib/whatsapp';

const faq = [
  { id: 'nfc', pregunta: '¿Mi celular sirve para NFC?', respuesta: 'Casi todos desde 2015 lo traen. En iPhone, del 7 en adelante; en Android está en Ajustes › Conexiones. Si el suyo no lo tiene, toda tarjeta trae un QR de respaldo.' },
  { id: 'enlace', pregunta: '¿Puedo cambiar el enlace después?', respuesta: 'Sí. El chip guarda una dirección, no el contenido: cambia a dónde apunta cuando quiera.' },
  { id: 'daño', pregunta: '¿Se daña la tarjeta?', respuesta: 'El PVC aguanta agua, sol y bolsillo. El chip no tiene batería: se alimenta del celular al acercarlo, así que no se descarga.' },
  { id: 'seguro', pregunta: '¿Es seguro acercar el celular a un tag?', respuesta: 'Sí. Un tag solo guarda una dirección web y su celular le muestra a dónde va antes de abrirla. No instala nada ni accede a sus datos.' },
];
---

<ServicioSimple
  titulo="Cómo funciona el NFC"
  descripcion="Qué es NFC y qué puede hacer un tag, sin tecnicismos."
  eyebrow="NFC"
  heroTitulo="Cómo funciona el NFC"
  heroSub="Qué es y qué puede hacer un tag, sin tecnicismos."
  waMensaje={MENSAJES.general}
  ctaHero="Tengo una duda"
  cierreTitulo="¿Le quedó una duda?"
  cierreTexto="Escríbanos y le explicamos, sin compromiso, qué le conviene."
>
  <section class="seccion">
    <div class="contenedor bloque-lectura">
      <p class="eyebrow" data-revelar>Qué es NFC</p>
      <h2 data-revelar style="--i:1">Un chip que guarda un enlace</h2>
      <p data-revelar style="--i:2">
        NFC es la misma tecnología con la que paga acercando la tarjeta al datáfono. Un tag es un
        chip sin batería, del tamaño de una moneda, que guarda <strong>una dirección web</strong>.
      </p>
      <p data-revelar style="--i:3">
        Al acercar el celular, el teléfono le da energía un instante, lee la dirección y ofrece
        abrirla. Sin apps, sin batería, y usted cambia a dónde apunta cuando quiera.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor bloque-estrecho">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">No las confunda</p>
        <h2>“Tags de rutinas” no es domótica</h2>
      </header>
      <div data-revelar>
        <Aviso variante="legal" titulo="La diferencia que importa">
          <p>
            <strong>Tags de rutinas</strong>: stickers de $15.000 que disparan una rutina del
            <em>celular</em> (No molestar, abrir una app). No controlan la casa.
          </p>
          <p>
            <strong>Domótica (Telar Casa)</strong>: Home Assistant sobre una Raspberry Pi, desde
            $1.200.000, que controla <em>dispositivos reales</em> —luces, sensores, cerraduras y
            cámaras—.
          </p>
        </Aviso>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor bloque-estrecho">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Dudas frecuentes</h2>
      </header>
      <FAQ client:visible items={faq} />
    </div>
  </section>
</ServicioSimple>

<style>
  .bloque-lectura h2 {
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    margin: 0.5rem 0 1.25rem;
  }
  .bloque-lectura p {
    color: var(--color-humo);
    line-height: 1.8;
    margin: 0 0 1rem;
  }
  .bloque-lectura strong {
    color: var(--color-lino);
  }
</style>
