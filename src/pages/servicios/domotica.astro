---
import Base from '../../layouts/Base.astro';
import TejidoHero from '../../components/trama/TejidoHero.astro';
import Pasos from '../../components/estaticos/Pasos.astro';
import NivelesPrecios from '../../components/ui/NivelesPrecios.astro';
import ListaSiNo from '../../components/ui/ListaSiNo.astro';
import Aviso from '../../components/ui/Aviso.astro';
import FAQ from '../../components/islas/FAQ.tsx';
import { linkWhatsApp, MENSAJES } from '../../lib/whatsapp';

const pasos = [
  { n: '01', titulo: 'Hablamos', texto: 'Nos cuenta qué quiere automatizar. Sin costo.' },
  { n: '02', titulo: 'Le mandamos la lista de compras', texto: 'Qué dispositivos comprar, dónde y cuánto cuestan. Los compra usted, a su nombre.' },
  { n: '03', titulo: 'Preparamos el equipo', texto: 'Le llega una Raspberry Pi configurada. La enchufa al router y ya.' },
  { n: '04', titulo: 'Configuramos', texto: 'Conectamos sus dispositivos y programamos las automatizaciones, remoto o presencial. Entre dos y cinco días.' },
  { n: '05', titulo: 'Le entregamos', texto: 'El sistema andando, con una sesión para aprender a usarlo. Todas las cuentas a su nombre.' },
];

const niveles = [
  {
    nombre: 'Básico',
    para: 'Apartamento, casa pequeña, Airbnb · 5–10 dispositivos',
    filas: [
      { celdas: ['Raspberry Pi 4 (4GB) configurada y lista para enchufar', '$650.000 – $700.000'] },
      { celdas: ['Instalación de Home Assistant + configuración inicial', '$250.000'] },
      { celdas: ['Integración de dispositivos (hasta 8–10)', 'Incluido'] },
      { celdas: ['Automatizaciones básicas (horarios, presencia, alertas WhatsApp/Telegram)', '$200.000'] },
      { celdas: ['Dashboard simple', '$100.000'] },
      { celdas: ['<strong>Total instalación</strong>', '<strong>$1.200.000 – $1.250.000</strong>'], destacado: true },
      { celdas: ['<strong>Mantenimiento mensual</strong>', '<strong>$60.000/mes</strong>'], destacado: true },
    ],
    wa: MENSAJES.domoticaBasico,
  },
  {
    nombre: 'Intermedio',
    para: 'Casa familiar, apartamento grande · 10–20 dispositivos, control por voz',
    filas: [
      { celdas: ['Raspberry Pi 4 (8GB) configurada y lista para enchufar', '$829.900'] },
      { celdas: ['Instalación de Home Assistant + configuración inicial', '$300.000'] },
      { celdas: ['Integración de dispositivos (hasta 15–20)', 'Incluido'] },
      { celdas: ['Automatizaciones avanzadas (condiciones múltiples, rutinas, clima, horarios cruzados)', '$400.000'] },
      { celdas: ['Integración con Alexa (control por voz)', '$150.000'] },
      { celdas: ['Nabu Casa (acceso remoto seguro) — configuración', '$80.000'] },
      { celdas: ['Dashboard personalizado', '$200.000'] },
      { celdas: ['<strong>Total instalación</strong>', '<strong>$1.960.000</strong>'], destacado: true },
      { celdas: ['<strong>Mantenimiento mensual</strong> (incluye Nabu Casa)', '<strong>$110.000/mes</strong>'], destacado: true },
    ],
    wa: MENSAJES.domoticaIntermedio,
  },
  {
    nombre: 'Premium',
    para: 'Pyme, oficina, casa grande · 20+ dispositivos, cámaras, UniFi',
    filas: [
      { celdas: ['Raspberry Pi 4 (8GB, recomendado) configurada', '$829.900'] },
      { celdas: ['Instalación de Home Assistant + configuración inicial', '$350.000'] },
      { celdas: ['Integración de dispositivos (20+)', 'Incluido'] },
      { celdas: ['Automatizaciones avanzadas (cámaras, notificaciones con foto/video, control de acceso)', '$700.000'] },
      { celdas: ['Integración completa con UniFi (Network + Protect + Access)', '$600.000'] },
      { celdas: ['Integración con Alexa', '$150.000'] },
      { celdas: ['Nabu Casa — configuración', '$80.000'] },
      { celdas: ['Dashboard ejecutivo con reportes', '$300.000'] },
      { celdas: ['<strong>Total instalación</strong>', '<strong>$3.010.000</strong>'], destacado: true },
      { celdas: ['<strong>Mantenimiento mensual</strong>', '<strong>$200.000 – $300.000/mes</strong>'], destacado: true },
    ],
    wa: MENSAJES.domoticaPremium,
  },
];

const incluye = [
  'Raspberry Pi configurada y lista para enchufar',
  'Programación e integración de Home Assistant',
  'Automatizaciones a la medida',
  'Dashboard personalizado',
  'Soporte y ajustes remotos (según plan de mantenimiento)',
  'Lista de compras de dispositivos compatibles',
];
const noIncluye = [
  'Enchufes inteligentes, sensores, bombillas',
  'Cerraduras inteligentes',
  'Cámaras de seguridad',
  'Equipos UniFi (routers, access points, cámaras Protect)',
  'Instalación física: cables, atornillar, montar',
  'Obra eléctrica de cualquier tipo',
];

const faq = [
  { id: 'casa', pregunta: '¿Lo hacen remoto o presencial?', respuesta: 'Como prefiera, ofrecemos ambas modalidades. En remoto le llega la Raspberry Pi ya configurada y lista para enchufar; presencial, vamos y lo dejamos funcionando. El montaje físico de dispositivos y el cableado los hace su electricista.' },
  { id: 'compra', pregunta: '¿Quién compra los dispositivos?', respuesta: 'Usted, con la lista que le damos. Así paga el precio de tienda sin sobrecosto nuestro, y las garantías quedan a su nombre.' },
  { id: 'luz', pregunta: '¿Y si se va la luz o el internet?', respuesta: 'Los dispositivos locales siguen respondiendo, pero las automatizaciones que dependen de internet se pausan hasta que vuelva. Recomendamos una UPS pequeña para la Raspberry.' },
  { id: 'voz', pregunta: '¿Puedo controlar todo por voz?', respuesta: 'Sí, desde el nivel Intermedio, integrando con Alexa.' },
  { id: 'remoto', pregunta: '¿Puedo ver mi casa desde el trabajo?', respuesta: 'Sí, con Nabu Casa, el acceso remoto oficial de Home Assistant. Nunca abrimos puertos en su router: es la práctica que deja los sistemas expuestos.' },
  { id: 'mantenimiento', pregunta: '¿Qué pasa si dejo de pagar el mantenimiento?', respuesta: 'El sistema sigue funcionando. Lo que pierdes son las actualizaciones, los respaldos y el soporte. Te avisamos por escrito y revocamos nuestro acceso.' },
  { id: 'camaras', pregunta: '¿Ustedes pueden ver mis cámaras?', respuesta: 'No entramos a sus grabaciones salvo que usted lo pida o haya una necesidad técnica que le documentamos. Todas las cuentas quedan a su nombre y firmamos un acuerdo de confidencialidad.' },
];

const waGeneral = linkWhatsApp(MENSAJES.domoticaGeneral);
---

<Base
  titulo="Domótica con Home Assistant"
  descripcion="Automatización para casa y oficina con Home Assistant, remoto o presencial. Luces, sensores, cámaras y rutinas. Desde $1.200.000."
  waMensaje={MENSAJES.domoticaGeneral}
>
  <TejidoHero
    eyebrow="Telar Casa · Home Assistant"
    titulo="Que su casa haga cosas sola"
    subtitulo="Automatización con Home Assistant. Luces que se apagan cuando sale, alertas cuando alguien llega, la oficina que se enciende antes que usted. Lo configuramos remoto o presencial y le queda listo."
  >
    <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn-oro">
      Cotizar por WhatsApp
    </a>
    <span class="hero-nota mono">Desde $1.200.000 · Remoto o presencial</span>
  </TejidoHero>

  <section class="seccion">
    <div class="contenedor bloque-lectura">
      <p class="eyebrow" data-revelar>El problema</p>
      <h2 data-revelar style="--i:1">Muchos aparatos “inteligentes”, ninguno se habla con el otro</h2>
      <p data-revelar style="--i:2">
        Compró un bombillo inteligente, un enchufe de otra marca y un sensor de otra. Cada uno con
        su app. Ninguno se habla con el otro.
      </p>
      <p data-revelar style="--i:3">
        Home Assistant los junta a todos y le deja crear reglas entre ellos:
        <em>si el sensor de la puerta se abre después de las 10 p.m., enciende la luz del pasillo y
        le envía una foto.</em>
      </p>
      <p data-revelar style="--i:4">
        Corre en un equipo suyo, en su casa. No depende de que una empresa mantenga su servicio en
        línea.
      </p>
    </div>
  </section>

  <section class="seccion banda">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Cómo funciona</p>
        <h2>De la lista de compras al sistema andando</h2>
      </header>
      <Pasos pasos={pasos} />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Los tres niveles</p>
        <h2>Elija según el tamaño de su casa</h2>
        <p class="intro">Todos los precios en pesos colombianos, sin IVA. El hardware se factura aparte del servicio.</p>
      </header>

      <NivelesPrecios niveles={niveles} />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Qué incluye y qué no</p>
        <h2>Claro desde el principio</h2>
      </header>
      <ListaSiNo incluye={incluye} noIncluye={noIncluye} />
      <div class="tras-lista" data-revelar>
        <Aviso variante="dato" titulo="Texto que va en cada cotización">
          <p>
            “El precio incluye la Raspberry Pi configurada y todo mi trabajo de programación e
            integración. No incluye enchufes, sensores, cerraduras, cámaras ni equipos UniFi —
            esos los compra usted directamente con la lista que le entrego, o los adquiere su
            técnico de confianza.”
          </p>
        </Aviso>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor bloque-estrecho">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Lo que preguntan antes de contratar</h2>
      </header>
      <FAQ client:visible items={faq} />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor bloque-estrecho">
      <Aviso variante="legal" titulo="Importante — léelo">
        <p>
          Este sistema de automatización no sustituye un sistema de alarma monitoreada, un servicio
          de vigilancia privada ni una póliza de seguros. Su funcionamiento depende de energía
          eléctrica, conexión a internet y de servicios de terceros (Home Assistant, Nabu Casa,
          UniFi, Alexa). Telar no se hace responsable por pérdidas, daños o incidentes derivados de
          fallas en cualquiera de estos elementos.
        </p>
      </Aviso>
    </div>
  </section>

  <section class="seccion cierre">
    <div class="contenedor bloque-estrecho centrado" data-revelar>
      <h2>Cuéntenos qué le gustaría que hiciera su casa</h2>
      <p class="intro">
        Le decimos si se puede, cuánto cuesta y qué necesita comprar. Sin compromiso.
      </p>
      <a href={waGeneral} target="_blank" rel="noopener noreferrer" class="btn-oro">
        Escribir por WhatsApp
      </a>
    </div>
  </section>
</Base>

<!-- Estilos de sección, niveles y bloque de lectura viven en global.css (compartidos). -->
