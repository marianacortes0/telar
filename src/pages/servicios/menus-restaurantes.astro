---
import ServicioSimple from '../../layouts/ServicioSimple.astro';
import TablaPrecios from '../../components/ui/TablaPrecios.astro';
import { MENSAJES } from '../../lib/whatsapp';

const filas = [
  { celdas: ['Table tent NFC (unidad)', '$30.000'] },
  { celdas: ['Sticker NFC para mesa o vitrina', '$15.000'] },
  { celdas: ['Tag de WiFi (conexión sin contraseña)', '$25.000'] },
  { celdas: ['Tag de reseñas en Google', '$25.000'] },
  { celdas: ['<strong>Paquete Restaurante</strong> — 10 table tents + carta digital + WiFi + Google Reviews', '<strong>$550.000</strong>'], destacado: true },
  { celdas: ['Actualización mensual de la carta', '$60.000/mes'] },
];
---

<ServicioSimple
  titulo="Menús digitales para restaurantes"
  descripcion="Table tents, stickers y tags NFC para restaurantes: carta digital, WiFi sin contraseña y reseñas en Google. Paquete Restaurante desde $550.000."
  eyebrow="Telar Tag · Restaurantes"
  heroTitulo="Su carta, de un toque en la mesa"
  heroSub="Table tents, posavasos o stickers en mesa. Un toque y el cliente ve la carta, se conecta al WiFi sin escribir contraseña, o te califica en Google."
  waMensaje={MENSAJES.restaurantes}
  precioNota="Paquete Restaurante $550.000"
  cierreTitulo="¿Montamos su carta digital?"
  cierreTexto="Le armamos el paquete completo y lo dejamos andando en sus mesas."
>
  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Precios</p>
        <h2>Del papel plastificado a la carta que se actualiza sola</h2>
        <p class="intro">Precios en pesos colombianos, sin IVA.</p>
      </header>
      <div data-revelar>
        <TablaPrecios filas={filas} />
      </div>
    </div>
  </section>
</ServicioSimple>
