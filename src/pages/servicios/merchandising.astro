---
import ServicioSimple from '../../layouts/ServicioSimple.astro';
import TablaPrecios from '../../components/ui/TablaPrecios.astro';
import { MENSAJES } from '../../lib/whatsapp';

const filas = [
  { celdas: ['Llavero NFC personalizado', '$35.000'] },
  { celdas: ['Pulsera NFC (eventos, gimnasios)', '$30.000'] },
  { celdas: ['Pin / botón NFC', '$28.000'] },
  { celdas: ['Lote 20+ unidades', 'Desde $22.000 c/u'] },
];
---

<ServicioSimple
  titulo="Merchandising NFC personalizado"
  descripcion="Llaveros, pulseras y pines NFC que abren Instagram, TikTok, un catálogo o su web. Para creadores, marcas y eventos. Desde $28.000."
  eyebrow="Telar Tag · Merchandising"
  heroTitulo="Un toque y están en su perfil"
  heroSub="Llaveros, pulseras y pines que abren Instagram, TikTok, un catálogo o una web. Para creadores de contenido, marcas y eventos."
  waMensaje={MENSAJES.merchandising}
  precioNota="Desde $28.000"
  cierreTitulo="¿Cuántos necesita?"
  cierreTexto="Cotizamos por unidad o por lote. Entre más, mejor precio."
>
  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Precios</p>
        <h2>Su marca, en el bolsillo de su público</h2>
        <p class="intro">Precios en pesos colombianos, sin IVA.</p>
      </header>
      <div data-revelar>
        <TablaPrecios filas={filas} />
      </div>
    </div>
  </section>
</ServicioSimple>
