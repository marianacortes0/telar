---
import Base from '../../layouts/Base.astro';
import TejidoHero from '../../components/trama/TejidoHero.astro';
import Pasos from '../../components/estaticos/Pasos.astro';
import TablaPrecios from '../../components/ui/TablaPrecios.astro';
import Aviso from '../../components/ui/Aviso.astro';
import { linkWhatsApp, MENSAJES } from '../../lib/whatsapp';

const niveles = [
  { celdas: ['Landing page', '1 página, responsive, formulario a WhatsApp, SEO básico, dominio y despliegue', '$700.000 – $1.100.000'] },
  { celdas: ['Portafolio profesional', '4–5 páginas, galería, blog, Google Search Console, Analytics', '$1.200.000 – $1.900.000'] },
  { celdas: ['Sitio corporativo', '6–10 páginas, blog con gestor de contenido, SEO técnico, schema, multi-formulario', '$1.900.000 – $3.200.000'] },
  { celdas: ['Sitio + panel de administración', 'Todo lo anterior + base de datos, autenticación, roles y CRUD completo para administrar el negocio', '$3.500.000 – $6.500.000'] },
  { celdas: ['Tienda en línea con pagos', 'Todo lo anterior + carrito, pasarela (Wompi / Mercado Pago), inventario, notificaciones', '$6.500.000 – $12.000.000'] },
];

const complementos = [
  { celdas: ['Configuración de Google Search Console + SEO técnico', '$350.000'] },
  { celdas: ['Migración de contenido desde sitio existente', '$300.000 – $700.000'] },
  { celdas: ['Integración con WhatsApp Business API', '$600.000'] },
  { celdas: ['Diseño desde cero (vs. adaptación de plantilla)', '+30%'] },
  { celdas: ['Multi-idioma', '+25%'] },
  { celdas: ['Hora adicional fuera de alcance', '$60.000/hora'] },
];

const pasos = [
  { n: '01', titulo: 'Hablamos', texto: 'Una llamada o un chat de WhatsApp. Entendemos qué necesita y le decimos de una si podemos hacerlo. Sin costo.' },
  { n: '02', titulo: 'Cotizamos por escrito', texto: 'Alcance detallado, precio cerrado y fecha de entrega. Lo que no está en la cotización, no está en el proyecto.' },
  { n: '03', titulo: 'Arrancamos con el 50%', texto: 'El anticipo confirma el cupo en la agenda.' },
  { n: '04', titulo: 'Construimos y mostramos', texto: 'Ve avances reales durante el proceso, no un mes de silencio y una sorpresa al final.' },
  { n: '05', titulo: 'Entregamos y acompañamos', texto: 'Todo queda a su nombre: dominio, cuentas, código. 30 días de garantía y planes de mantenimiento si los quiere.' },
];

const waWeb = linkWhatsApp(MENSAJES.web);
---

<Base
  titulo="Desarrollo web a la medida"
  descripcion="Páginas web, sitios corporativos, paneles de administración y tiendas en línea. Diseño, frontend, backend, base de datos y pagos. Una sola persona responsable de todo el proyecto."
  waMensaje={MENSAJES.web}
>
  <TejidoHero
    eyebrow="Telar Web · Desarrollo a la medida"
    titulo="Su web, de principio a fin"
    subtitulo="Diseño, frontend, backend, base de datos, SEO y pasarela de pagos. Un equipo responsable de todo el proyecto, desde la landing hasta el panel que administra su negocio."
  >
    <a href={waWeb} target="_blank" rel="noopener noreferrer" class="btn-oro">
      Hablemos del proyecto
    </a>
    <a href="/precios" class="btn-linea">Ver todos los precios</a>
  </TejidoHero>

  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Niveles</p>
        <h2>Desde una landing hasta una tienda con pagos</h2>
        <p class="intro">
          Proceso completo: diseño, frontend, backend, base de datos, Google Search Console,
          pasarela de pagos y panel de administración.
        </p>
      </header>

      <div data-revelar>
        <TablaPrecios encabezados={['Nivel', 'Alcance', 'Precio']} filas={niveles} />
      </div>

      <div class="tras-tabla" data-revelar>
        <Aviso variante="dato" titulo="Ventaja del desarrollo web">
          <p>
            El desarrollo web y el hosting están <strong>excluidos de IVA</strong> (Art. 476 num. 21
            del Estatuto Tributario). A diferencia del hardware, estos precios no cambian cuando
            Telar pase a ser responsable de IVA.
          </p>
        </Aviso>
      </div>
    </div>
  </section>

  <section class="seccion proceso">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2>Sin sorpresas, todo por escrito</h2>
      </header>
      <Pasos pasos={pasos} />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <p class="eyebrow">Complementos</p>
        <h2>Súmale lo que necesites</h2>
      </header>
      <div data-revelar>
        <TablaPrecios encabezados={['Servicio', 'Precio']} filas={complementos} />
      </div>
    </div>
  </section>

  <section class="seccion cierre">
    <div class="contenedor bloque-estrecho centrado" data-revelar>
      <h2>¿Tiene un proyecto en mente?</h2>
      <p class="intro">
        Cuéntenos qué necesita y le damos alcance, precio cerrado y fecha de entrega por escrito.
      </p>
      <a href={waWeb} target="_blank" rel="noopener noreferrer" class="btn-oro">
        Escribir por WhatsApp
      </a>
    </div>
  </section>
</Base>

<style>
  .encabezado-seccion {
    max-width: 42rem;
    margin-bottom: 2.5rem;
  }
  .encabezado-seccion h2 {
    font-size: clamp(1.7rem, 4.5vw, 2.6rem);
    margin: 0;
  }
  .intro {
    color: var(--color-humo);
    margin: 1rem 0 0;
    line-height: 1.7;
  }
  .proceso {
    background: color-mix(in srgb, var(--color-fondo) 45%, var(--color-abismo));
    border-block: 1px solid var(--color-borde);
  }
  .tras-tabla {
    margin-top: 1.5rem;
  }
  .bloque-estrecho {
    max-width: 46rem;
  }
  .centrado {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .centrado h2 {
    font-size: clamp(1.7rem, 5vw, 2.6rem);
    margin: 0;
  }
  .cierre {
    text-align: center;
  }
</style>
