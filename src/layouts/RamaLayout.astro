---
/**
 * Estructura común de las 8 ramas (v8, §6):
 * 1. título y subtítulo · 2. el problema · 3. niveles con su "Desde" (slot) ·
 * 4. combo · 5. casos · 6. preguntas frecuentes · 7. suscripción Telar · 8. Cotizar.
 * El slot "extra" va tras los niveles (descargos, lista de compras).
 */
import Base from './Base.astro';
import TejidoHero from '../components/trama/TejidoHero.astro';
import type { ItemFAQ } from '../components/islas/FAQ.tsx';
import SeccionFAQ from '../components/estaticos/SeccionFAQ.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import fondoCierre from '../assets/ramas/fondo-cierre.jpg';
import { CAPAS, type IdCapa } from '../lib/navegacion';
import { formatoCOP, DESCUENTO_COMBO, type Combo } from '../lib/precios';
import { linkWhatsApp } from '../lib/whatsapp';

export interface Caso {
  titulo: string;
  texto: string;
  /** Ilustración del caso (opcional). */
  imagen?: { src: ImageMetadata; alt: string };
}

interface Props {
  titulo: string;
  descripcion: string;
  rama: string;
  capa: IdCapa;
  heroTitulo: string;
  heroSub: string;
  /** "Desde" más bajo de la rama (sale de lib/precios). */
  desde: number;
  conIva?: boolean;
  waMensaje: string;
  problema: { titulo: string; parrafos: string[] };
  combo?: Combo;
  casos: Caso[];
  faq: ItemFAQ[];
  /** Telar Tag no necesita suscripción. */
  suscripcion?: boolean;
  cierreTitulo: string;
}

const {
  titulo,
  descripcion,
  rama,
  capa,
  heroTitulo,
  heroSub,
  desde,
  conIva = true,
  waMensaje,
  problema,
  combo,
  casos,
  faq,
  suscripcion = true,
  cierreTitulo,
} = Astro.props;

// Imagen animada junto al problema (components/escenas), opcional por rama.
const conEscena = Astro.slots.has('escena');
const datosCapa = CAPAS.find((c) => c.id === capa)!;
const wa = linkWhatsApp(waMensaje);
// Nodos dorados y verdes del fondo del cierre (lienzo 2000 × 1116) que laten.
const nodosCierre = [
  { x: 727, y: 238, oro: true },
  { x: 999, y: 235, oro: true },
  { x: 1488, y: 880, oro: true },
  { x: 1786, y: 535, oro: true },
  { x: 200, y: 603, oro: true },
  { x: 220, y: 912, oro: true },
  { x: 95, y: 697, oro: false },
  { x: 1806, y: 323, oro: false },
  { x: 268, y: 864, oro: false },
];
const descuento = `${Math.round(DESCUENTO_COMBO * 100)} %`;
---

<Base titulo={titulo} descripcion={descripcion} waMensaje={waMensaje}>
  <TejidoHero
    titulo={heroTitulo}
    subtitulo={heroSub}
  >
    <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-oro">Cotizar</a>
    <a href="#niveles" class="btn-linea">Ver niveles</a>
    <span class="hero-nota mono">
      Desde {formatoCOP(desde)} · {conIva ? 'IVA incluido' : 'excluido de IVA'}
    </span>
  </TejidoHero>

  <nav class="mapa-capas" aria-label={`Ramas de ${datosCapa.nombre}`}>
    <div class="contenedor mapa">
      <p class="capa-actual">
        <span class="mono">0{CAPAS.indexOf(datosCapa) + 1}</span>
        {datosCapa.nombre}
      </p>
      <ul class="ramas-capa">
        {
          datosCapa.ramas.map((r) => (
            <li>
              <a
                href={r.href}
                class:list={['rama-tab', { activa: r.label === rama }]}
                aria-current={r.label === rama ? 'page' : undefined}
              >
                {r.icono && <Icon name={r.icono} class="tab-icono" aria-hidden="true" />}
                {r.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <section class="seccion">
    <div class:list={['contenedor', { 'problema-con-imagen': conEscena }]}>
      <div class="bloque-lectura">
        <h2 data-revelar>{problema.titulo}</h2>
        {problema.parrafos.map((p, i) => <p data-revelar style={`--i:${i + 1}`} set:html={p} />)}
      </div>

      <slot name="escena" />
    </div>
  </section>

  <section id="niveles" class="seccion banda">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <h2>Esencial, Conectado o Integral</h2>
        <p class="subtitulo">Del nivel más básico al más completo.</p>
      </header>

      <slot />

      {
        combo && (
          <article class="card combo" data-revelar>
            <div class="combo-titulo">
              <span class="combo-etiqueta">Combo</span>
              <h3>{combo.nombre}</h3>
            </div>
            <div class="combo-partes">
              {combo.partes.map((p, i) => (
                <>
                  {i > 0 && (
                    <Icon name="lucide:plus" class="signo" aria-hidden="true" />
                  )}
                  <span class="parte">{p.nombre}</span>
                </>
              ))}
            </div>
            <div class="combo-precio">
              <span class="separado">Por separado {formatoCOP(combo.separado)}</span>
              <span class="precio">Desde {formatoCOP(combo.desde)}</span>
              <span class="ahorro">{descuento} menos</span>
            </div>
          </article>
        )
      }

      <slot name="extra" />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <header class="encabezado-seccion" data-revelar>
        <h2>Así se usa</h2>
      </header>
      <div class="casos">
        {
          casos.map((c, i) => (
            <article class:list={['card', 'caso', { 'con-imagen': c.imagen }]} data-revelar style={`--i:${i}`}>
              <span class="caso-n mono">0{i + 1}</span>
              <h3>{c.titulo}</h3>
              {c.imagen && (
                <div
                  class="caso-img"
                  style={`aspect-ratio: ${c.imagen.src.width} / ${c.imagen.src.height}`}
                >
                  <Image
                    src={c.imagen.src}
                    alt={c.imagen.alt}
                    widths={[400, 600, 900]}
                    sizes="(min-width: 64rem) 22rem, (min-width: 48rem) 45vw, 92vw"
                  />
                </div>
              )}
              <p set:html={c.texto} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <SeccionFAQ titulo="Lo que preguntan antes de contratar" items={faq} />

  <section class="seccion cierre-rama">
    <div class="contenedor">
      <div class="cierre-tarjeta" data-revelar>
        <div class="cierre-fondo" data-fondo aria-hidden="true">
          <Image
            src={fondoCierre}
            alt=""
            widths={[800, 1400, 1920]}
            sizes="(min-width: 72rem) 68rem, 100vw"
            class="cierre-img"
          />
          <svg class="cierre-nodos" viewBox="0 0 2000 1116" preserveAspectRatio="xMidYMid slice">
            {
              nodosCierre.map((n, i) => (
                <circle
                  class:list={['latido', { oro: n.oro }]}
                  cx={n.x}
                  cy={n.y}
                  r="28"
                  style={`--i:${i}`}
                />
              ))
            }
          </svg>
        </div>
        <div class="cierre-contenido centrado">
      <h2>{cierreTitulo}</h2>
      {
        suscripcion ? (
          <p class="intro">
            Funciona con su <a href="/cotizar#suscripcion" class="enlace-oro">suscripción Telar</a>.
          </p>
        ) : (
          <p class="intro">
            Pago único, sin mensualidad. <a href="/cotizar" class="enlace-oro">Así cotizamos</a>.
          </p>
        )
      }
      <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-oro">Cotizar</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Cierre: tarjeta con fondo de circuitos animado ──────── */
  .cierre-tarjeta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: clamp(22rem, 38vw, 28rem);
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 5vw, 3rem);
    border: 1px solid var(--color-borde);
    border-radius: 24px;
    background: var(--color-abismo);
    text-align: center;
  }
  .cierre-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    animation: acercar 22s ease-in-out infinite alternate;
  }
  /* Velo central para que el texto se lea sobre los circuitos */
  .cierre-fondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 55% 60% at 50% 50%,
      color-mix(in srgb, var(--color-abismo) 70%, transparent),
      transparent 75%
    );
  }
  .cierre-fondo :global(.cierre-img),
  .cierre-nodos {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cierre-fondo :global(.cierre-img) {
    object-fit: cover;
  }
  .latido {
    fill: none;
    stroke: var(--color-teal-luz);
    stroke-width: 4;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: latido-nodo 3.6s var(--ease-salida) infinite;
    animation-delay: calc(var(--i) * 0.55s);
  }
  .latido.oro {
    stroke: var(--color-oro);
  }
  .cierre-contenido {
    position: relative;
    max-width: 40rem;
  }
  .cierre-contenido h2 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
  }
  @keyframes acercar {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }
  @keyframes latido-nodo {
    0% {
      opacity: 0.9;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(2.2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cierre-fondo,
    .latido {
      animation: none;
    }
  }

  /* ── Problema con escena animada al lado ────────────────── */
  .problema-con-imagen {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .problema-con-imagen {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .mapa-capas {
    border-block: 1px solid var(--color-borde);
    background: color-mix(in srgb, var(--color-fondo) 35%, var(--color-abismo));
  }
  .mapa {
    display: flex;
    align-items: stretch;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .capa-actual {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding-right: 1.5rem;
    border-right: 1px solid var(--color-borde);
    color: var(--color-humo);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .capa-actual .mono {
    color: var(--color-oro);
    font-size: 0.75rem;
  }
  .ramas-capa {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }
  .rama-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0.95rem 0.85rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--color-humo);
    text-decoration: none;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: color var(--dur-rapido) var(--ease-precision);
  }
  .rama-tab:hover {
    color: var(--color-lino);
  }
  .rama-tab.activa {
    color: var(--color-lino);
    border-bottom-color: var(--color-oro);
  }
  .rama-tab :global(.tab-icono) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-teal-luz);
  }
  .rama-tab.activa :global(.tab-icono) {
    color: var(--color-oro);
  }
  /* En móvil solo las pestañas de las ramas, para que quepan sin desplazamiento */
  @media (max-width: 47.99rem) {
    .capa-actual {
      display: none;
    }
    .ramas-capa {
      width: 100%;
      justify-content: space-between;
    }
    .rama-tab {
      padding-inline: 0.4rem;
      font-size: 0.88rem;
      gap: 0.35rem;
    }
  }
  /* Celulares angostos (≤ 400 px): sin íconos para que quepan las tres ramas */
  @media (max-width: 25rem) {
    .rama-tab :global(.tab-icono) {
      display: none;
    }
    .rama-tab {
      padding-inline: 0.3rem;
      font-size: 0.84rem;
    }
  }

  .subtitulo {
    color: var(--color-humo);
    margin: 0.75rem 0 0;
  }

  .combo {
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border-color: color-mix(in srgb, var(--color-oro) 45%, var(--color-borde));
  }
  .combo-etiqueta {
    font-family: var(--fuente-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-oro);
  }
  .combo h3 {
    font-family: var(--fuente-display);
    font-size: 1.5rem;
    margin: 0.25rem 0 0;
  }
  .combo-partes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .parte {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-borde);
    border-radius: 10px;
    background: var(--color-abismo);
    font-size: 0.95rem;
  }
  .combo :global(.signo) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-oro);
  }
  .combo-precio {
    display: grid;
    gap: 0.1rem;
  }
  .separado {
    color: var(--color-humo);
    font-size: 0.85rem;
  }
  .combo .precio {
    color: var(--color-oro);
    font-size: clamp(1.4rem, 3vw, 1.7rem);
  }
  .ahorro {
    color: var(--color-teal-luz);
    font-size: 0.85rem;
  }
  @media (min-width: 64rem) {
    .combo {
      grid-template-columns: 1fr 1.6fr auto;
      align-items: center;
      gap: 2rem;
    }
    .combo-precio {
      text-align: right;
    }
  }

  .caso-n {
    display: block;
    color: var(--color-oro);
    font-size: 0.8rem;
    margin-bottom: 0.6rem;
  }

  /* Caso con ilustración: la imagen se acerca al aparecer y un poco más al pasar el cursor */
  .caso.con-imagen {
    display: flex;
    flex-direction: column;
  }
  /* Títulos de una o dos líneas: las imágenes arrancan a la misma altura */
  @media (min-width: 48rem) {
    .caso.con-imagen h3 {
      min-height: 2.3em;
    }
  }
  .caso-img {
    order: 1;
    margin: 1rem 0 1.1rem;
    aspect-ratio: 4 / 3; /* respaldo; cada imagen pone su proporción real */
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-borde);
    background: var(--color-abismo);
  }
  .caso.con-imagen > p {
    order: 2;
  }
  /* scale (acercamiento) y translate (flotar) son propiedades separadas: no chocan */
  .caso-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: 1.14;
    transition: scale 1.4s var(--ease-salida);
    animation: flotar-caso 6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -2s);
  }
  /* Base 1.04: deja margen para que al flotar nunca se vea el borde del marco */
  .caso.visible .caso-img :global(img) {
    scale: 1.04;
  }
  .caso.visible:hover .caso-img :global(img) {
    scale: 1.09;
    transition-duration: 0.6s;
  }
  @keyframes flotar-caso {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caso-img :global(img),
    .caso.visible:hover .caso-img :global(img) {
      scale: 1;
      transition: none;
      animation: none;
    }
  }

</style>
