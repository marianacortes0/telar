---
import Base from './Base.astro';

interface Props {
  titulo: string;
  descripcion: string;
  actualizado?: string;
}
const { titulo, descripcion, actualizado = 'Octubre de 2026' } = Astro.props;
---

<!-- noindex mientras el abogado no apruebe los textos (TODO en CLAUDE.md) -->
<Base titulo={titulo} descripcion={descripcion} noindex={true}>
  <section class="seccion">
    <div class="contenedor bloque-lectura">
      <h1 class="titulo-legal">{titulo}</h1>
      <p class="meta">Última actualización: {actualizado}</p>

      <div class="prosa">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .titulo-legal {
    font-size: clamp(2rem, 5vw, 2.8rem);
    margin: 0 0 0.5rem;
  }
  .meta {
    color: var(--color-humo);
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    margin: 0 0 2.5rem;
  }
</style>
