---
import { Image } from 'astro:assets';

interface Props {
  titulo: string;
  subtitulo?: string;
  eyebrow?: string;
  class?: string;
  /**
   * Ilustración de fondo (2000 × 1116 o proporción parecida, con la parte de arriba
   * despejada para el título). Reemplaza la trama: título arriba, botones abajo.
   */
  fondo?: { src: ImageMetadata; alt: string };
  /**
   * Video de fondo (ruta en public/). Se repite mientras el hero está en pantalla
   * y se pausa cuando no se ve o la pestaña está oculta. En escritorio ocupa la
   * derecha y se funde hacia el texto; en celular va debajo del texto.
   */
  video?: { src: string; poster: string };
}
const { titulo, subtitulo, eyebrow, class: clase = '', fondo, video } = Astro.props;

// Brillos sobre la ilustración de Telar para todos, en un lienzo de 2000 × 1116.
const brillos = [
  { x: 1185, y: 318, r: 14 },
  { x: 1300, y: 600, r: 16 },
  { x: 820, y: 640, r: 14 },
  { x: 1190, y: 850, r: 18 },
  { x: 1040, y: 760, r: 12 },
];
const estrella = ({ x, y, r }: { x: number; y: number; r: number }) => {
  const c = r * 0.28;
  return `M${x} ${y - r}L${x + c} ${y - c}L${x + r} ${y}L${x + c} ${y + c}L${x} ${y + r}L${x - c} ${y + c}L${x - r} ${y}L${x - c} ${y - c}Z`;
};

const N = {
  L: { x: 246, y: 148 },
  TR: { x: 954, y: 114 },
  R: { x: 1088, y: 260 },
  BR: { x: 966, y: 400 },
  BL: { x: 264, y: 396 },
};

const hilos = [
  { a: 'L', b: 'TR', color: 'teal' },
  { a: 'L', b: 'BR', color: 'teal' },
  { a: 'BL', b: 'R', color: 'teal' },
  { a: 'R', b: 'BR', color: 'teal' },
  { a: 'BL', b: 'TR', color: 'oro' },
  { a: 'TR', b: 'BR', color: 'oro' },
].map((h, i) => {
  const p = N[h.a as keyof typeof N];
  const q = N[h.b as keyof typeof N];
  return {
    ...h,
    x1: p.x,
    y1: p.y,
    x2: q.x,
    y2: q.y,
    largo: Math.round(Math.hypot(q.x - p.x, q.y - p.y)),
    i,
  };
});

const nodos = [
  { ...N.L, color: 'teal', i: 0 },
  { ...N.TR, color: 'oro', i: 1 },
  { ...N.R, color: 'teal', i: 2 },
  { ...N.BR, color: 'teal', i: 3 },
  { ...N.BL, color: 'oro', i: 4 },
];

const barras = [430, 600, 770];
---

<section class:list={['hero', clase, { 'con-fondo': fondo, 'con-video': video }]}>
  {
    fondo && (
      <div class="fondo" data-fondo>
        <Image
          src={fondo.src}
          alt={fondo.alt}
          widths={[800, 1200, 1600, 2000, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="fondo-img"
        />
        <svg class="fondo-luz" viewBox="0 0 2000 1116" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="luz-telar">
              <stop offset="0%" stop-color="#ffe7a8" stop-opacity="0.75" />
              <stop offset="100%" stop-color="#ffe7a8" stop-opacity="0" />
            </radialGradient>
          </defs>
          <ellipse class="resplandor-telar" cx="1010" cy="470" rx="230" ry="150" fill="url(#luz-telar)" />
          <ellipse class="resplandor-telar puerta" cx="1730" cy="520" rx="110" ry="190" fill="url(#luz-telar)" />
          {brillos.map((b, i) => <path class="brillo" d={estrella(b)} style={`--i:${i}`} />)}
        </svg>
      </div>
    )
  }
  <svg
    class="trama"
    viewBox="0 0 1200 520"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <g fill="none" stroke-linecap="round">
      <g class="urdimbre" stroke="var(--color-borde)" stroke-width="2">
        {barras.map((x, i) => (
          <line class="hebra" x1={x} y1={70} x2={x} y2={450} style={`--largo:380; --i:${i}`} />
        ))}
        <line class="hebra" x1={120} y1={260} x2={1080} y2={260} style="--largo:960; --i:3" />
      </g>

      <g class="hilos">
        {hilos.map((h) => (
          <line
            class="hebra"
            x1={h.x1}
            y1={h.y1}
            x2={h.x2}
            y2={h.y2}
            stroke={h.color === 'oro' ? 'var(--color-oro)' : 'var(--color-teal)'}
            stroke-width="1.6"
            style={`--largo:${h.largo}; --i:${h.i + 4}`}
          />
        ))}
      </g>

      <g class="nodos">
        {nodos.map((n) => (
          <circle
            class="nodo"
            cx={n.x}
            cy={n.y}
            r="7"
            fill={n.color === 'oro' ? 'var(--color-oro)' : 'var(--color-teal)'}
            style={`--i:${n.i}`}
          />
        ))}
      </g>
    </g>
  </svg>

  <div class="contenido">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{titulo}</h1>
    {subtitulo && <p class="sub">{subtitulo}</p>}
    <div class="acciones"><slot /></div>
  </div>

  {
    video && (
      <div class="video-fondo">
        <video
          muted
          loop
          playsinline
          preload="auto"
          poster={video.poster}
          aria-hidden="true"
          tabindex="-1"
          data-video-hero
        >
          <source src={video.src} type="video/mp4" />
        </video>
      </div>
    )
  }
</section>

<script>
  // Reproduce el video del hero solo cuando se ve: fuera de pantalla, con la
  // pestaña oculta, con "reducir movimiento" o con ahorro de datos, se pausa
  // (se queda el póster). Así no consume CPU ni batería mientras no se mira.
  const v = document.querySelector<HTMLVideoElement>('[data-video-hero]');
  if (v) {
    const quieto = matchMedia('(prefers-reduced-motion: reduce)');
    const red = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let enPantalla = false;
    const decidir = () => {
      if (enPantalla && !document.hidden && !quieto.matches && !red?.saveData) {
        v.play().catch(() => {});
      } else {
        v.pause();
      }
    };
    new IntersectionObserver(
      ([e]) => {
        enPantalla = e.isIntersecting;
        decidir();
      },
      { threshold: 0.2 }
    ).observe(v);
    document.addEventListener('visibilitychange', decidir);
    quieto.addEventListener('change', decidir);
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: clamp(440px, 62vh, 620px);
    min-height: clamp(440px, 62dvh, 620px);
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4rem);
    overflow: hidden;
  }

  .trama {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.55;
  }

  .contenido {
    max-width: 46rem;
    width: min(100%, 72rem);
    margin-inline: auto;
  }

  .contenido h1 {
    font-size: clamp(2.1rem, 6vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-lino);
    margin: 0;
  }

  .sub {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-humo);
    margin: 1.25rem 0 0;
    max-width: 34rem;
    text-wrap: pretty;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .acciones:empty {
    display: none;
  }

  .hebra {
    stroke-dasharray: var(--largo);
    stroke-dashoffset: var(--largo);
    animation: tejer var(--dur-trama) var(--ease-precision) forwards;
    animation-delay: calc(var(--i) * var(--stagger));
  }

  .nodo {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: encender var(--dur-medio) var(--ease-nodo) forwards;
    animation-delay: calc(var(--dur-trama) * 0.62 + var(--i) * var(--stagger));
  }

  @keyframes tejer {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes encender {
    0% {
      opacity: 0;
      transform: scale(0);
    }
    62% {
      opacity: 1;
      transform: scale(1.45);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ── Con video de fondo ──────────────────────────────── */
  .con-video .trama {
    display: none;
  }
  .con-video .contenido {
    position: relative;
    z-index: 1;
  }
  .video-fondo {
    position: relative;
    margin: 2rem calc(-1 * clamp(1.25rem, 5vw, 4rem)) calc(-1 * clamp(3rem, 8vw, 6rem));
    aspect-ratio: 16 / 9;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 84%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 84%, transparent 100%);
  }
  .video-fondo video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* En pantallas anchas el video llena la derecha y el texto queda a la izquierda */
  @media (min-width: 64rem) {
    .con-video {
      min-height: min(88dvh, 52rem);
    }
    .con-video .contenido {
      max-width: none;
    }
    .con-video h1 {
      max-width: 15ch;
      font-size: clamp(2.4rem, 4.4vw, 3.8rem);
    }
    .con-video .sub {
      max-width: 30rem;
    }
    .video-fondo {
      position: absolute;
      inset: 0 0 0 38%;
      z-index: -1;
      margin: 0;
      aspect-ratio: auto;
      -webkit-mask-image:
        linear-gradient(90deg, transparent 0, #000 32%),
        linear-gradient(180deg, transparent 0, #000 10%, #000 88%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(90deg, transparent 0, #000 32%),
        linear-gradient(180deg, transparent 0, #000 10%, #000 88%, transparent 100%);
      mask-composite: intersect;
    }
  }
  /* Pantallas medianas: el video se corre más a la derecha para no rozar el texto */
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .video-fondo {
      left: 44%;
    }
  }

  /* ── Con ilustración de fondo ─────────────────────────── */
  .con-fondo {
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  .con-fondo .trama {
    display: none;
  }
  .con-fondo .contenido {
    position: relative;
    z-index: 1;
  }
  .con-fondo .sub {
    margin-inline: auto;
  }
  .con-fondo .acciones {
    justify-content: center;
  }
  .fondo {
    position: relative;
    align-self: stretch;
    margin: 2rem calc(-1 * clamp(1.25rem, 5vw, 4rem)) calc(-1 * clamp(3rem, 8vw, 6rem));
    aspect-ratio: 2000 / 1116;
    overflow: hidden;
    order: 2;
    /* Se funde con la página por arriba y por abajo */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 18%, #000 85%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 18%, #000 85%, transparent 100%);
  }
  .fondo-img,
  .fondo-luz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fondo-img {
    object-fit: cover;
    object-position: 50% 100%;
    animation: acercar-fondo 24s ease-in-out infinite alternate;
  }
  .resplandor-telar {
    mix-blend-mode: screen;
    transform-box: fill-box;
    transform-origin: center;
    animation: respirar-telar 4.5s ease-in-out infinite;
  }
  .resplandor-telar.puerta {
    animation-delay: 2.2s;
  }
  .brillo {
    fill: #fff3cf;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: centellear-telar 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.43s);
  }
  @keyframes acercar-fondo {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
  @keyframes respirar-telar {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.06);
    }
  }
  @keyframes centellear-telar {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.2) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: scale(1) rotate(45deg);
    }
  }

  /* En pantallas anchas la ilustración llena el hero: título arriba, botones abajo */
  @media (min-width: 48rem) {
    /* La ilustración va completa abajo; encima queda espacio para el título */
    .con-fondo {
      min-height: calc(100vw * 1116 / 2000 + 5rem);
      padding-bottom: clamp(2rem, 4vw, 3.5rem);
    }
    .fondo {
      position: absolute;
      inset: auto 0 0;
      margin: 0;
      z-index: -1;
      -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 80%, transparent 100%);
      mask-image: linear-gradient(180deg, transparent 0, #000 12%, #000 80%, transparent 100%);
    }
    /* Velo arriba para que el título se lea sobre la ilustración */
    .fondo::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-abismo) 55%, transparent),
        transparent 35%
      );
    }
    .con-fondo .contenido {
      flex: 1;
      display: flex;
      flex-direction: column;
      max-width: 52rem;
    }
    .con-fondo .acciones {
      margin-top: auto;
      padding-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fondo-img,
    .resplandor-telar,
    .brillo {
      animation: none;
    }
    .hebra {
      animation: none;
      stroke-dashoffset: 0;
    }
    .nodo {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .trama {
      opacity: 0.38;
    }
    .urdimbre {
      display: none;
    }
  }
</style>
