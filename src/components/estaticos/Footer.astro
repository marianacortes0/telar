---
import { Image } from 'astro:assets';
import LogoTelar from '../marca/LogoTelar.astro';
import fondoPie from '../../assets/ramas/footer.jpg';
import { NEGOCIO } from '../../lib/constantes';
import { linkWhatsApp, MENSAJES } from '../../lib/whatsapp';
import { NAV_RAMAS, NAV_TELAR, NAV_LEGAL } from '../../lib/navegacion';

const anio = new Date().getFullYear();

// Nodos que brillan sobre la ilustración del fondo (lienzo de 2000 × 1116).
const destellos = [
  { x: 520, y: 622 },
  { x: 1203, y: 710 },
  { x: 648, y: 763 },
  { x: 385, y: 623 },
  { x: 1805, y: 783 },
  { x: 1630, y: 752 },
  { x: 93, y: 688 },
];
const wa = linkWhatsApp(MENSAJES.general);
---

<footer class="pie">
  <!-- Ilustración de fondo: hilos que unen la vereda con la ciudad, atenuada para no competir con el texto -->
  <div class="pie-fondo" data-fondo aria-hidden="true">
    <Image src={fondoPie} alt="" widths={[800, 1200, 1600, 2000, 2400]} sizes="100vw" class="pie-img" />
    <svg viewBox="0 0 2000 1116" preserveAspectRatio="xMidYMax slice" focusable="false">
      <defs>
        <radialGradient id="destello-pie">
          <stop offset="0%" stop-color="#fff3cf" stop-opacity="0.9"></stop>
          <stop offset="100%" stop-color="#fff3cf" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      {
        destellos.map((d, i) => (
          <circle class="pie-destello" cx={d.x} cy={d.y} r="34" fill="url(#destello-pie)" style={`--i:${i}`} />
        ))
      }
    </svg>
  </div>

  <div class="contenedor">
    <div class="rejilla">
      <div class="marca">
        <LogoTelar tamano={30} variante="mono" />
        <p class="lema">{NEGOCIO.eslogan}.</p>
        <a href={wa} target="_blank" rel="noopener noreferrer" class="btn-linea">
          Hablemos por WhatsApp
        </a>
      </div>

      <nav class="columna" aria-label="Ramas">
        <h2>Ramas</h2>
        <ul>
          {NAV_RAMAS.map((e) => <li><a href={e.href}>{e.label}</a></li>)}
        </ul>
      </nav>

      <nav class="columna" aria-label="Telar">
        <h2>Telar</h2>
        <ul>
          {NAV_TELAR.map((e) => <li><a href={e.href}>{e.label}</a></li>)}
        </ul>
      </nav>

      <nav class="columna" aria-label="Legal">
        <h2>Legal</h2>
        <ul>
          {NAV_LEGAL.map((e) => <li><a href={e.href}>{e.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="identificacion">
      <p>
        <strong>{NEGOCIO.nombre} {NEGOCIO.sociedad}</strong> · {NEGOCIO.ciudad}, {NEGOCIO.pais}<br />
        WhatsApp: {NEGOCIO.telefonoVisible} · {NEGOCIO.email}
      </p>
      <p class="copy">© {anio} {NEGOCIO.nombre}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 4rem;
    border-top: 1px solid var(--color-borde);
    background: color-mix(in srgb, var(--color-fondo) 40%, var(--color-abismo));
    padding-block: clamp(2.5rem, 6vw, 4rem);
    font-size: 0.95rem;
  }

  /* ── Fondo ilustrado ─────────────────────────────────────── */
  .pie-fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .pie-img,
  .pie-fondo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pie-img {
    object-fit: cover;
    object-position: 50% 100%;
    opacity: 0.5;
  }
  /* Velo: más oscuro donde están los enlaces, para que el texto mande */
  .pie-fondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-abismo) 78%, transparent) 0,
        color-mix(in srgb, var(--color-abismo) 62%, transparent) 60%,
        color-mix(in srgb, var(--color-abismo) 50%, transparent) 100%
      );
  }
  .pie-destello {
    mix-blend-mode: screen;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: destellar-pie 3.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.6s);
  }
  @keyframes destellar-pie {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.6);
    }
    50% {
      opacity: 0.55;
      transform: scale(1.2);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pie-destello {
      animation: none;
    }
  }

  .rejilla {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .marca {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    color: var(--color-lino);
  }
  .lema {
    color: var(--color-humo);
    margin: 0;
    max-width: 22rem;
  }

  .columna h2 {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal-luz);
    margin: 0 0 1rem;
  }
  .columna ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .columna a {
    color: var(--color-humo);
    text-decoration: none;
    display: inline-block;
    padding: 0.15rem 0;
  }
  .columna a:hover {
    color: var(--color-lino);
  }

  .identificacion {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-borde);
    color: var(--color-humo);
    line-height: 1.8;
  }
  .identificacion p {
    margin: 0 0 0.75rem;
  }
  .copy {
    font-size: 0.85rem;
  }

  @media (min-width: 48rem) {
    .rejilla {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .marca {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .rejilla {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
    .marca {
      grid-column: auto;
    }
  }
</style>
