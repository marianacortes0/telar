---
import { linkWhatsApp, MENSAJES } from '../../lib/whatsapp';

interface Props {
  mensaje?: string;
}
const { mensaje = MENSAJES.general } = Astro.props;
const href = linkWhatsApp(mensaje);
---

<a
  href={href}
  class="wa-flotante"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  data-wa-flotante
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.6.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4Z"
    />
    <path
      d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Z"
    />
  </svg>
</a>

<script>
  const boton = document.querySelector<HTMLElement>('[data-wa-flotante]');
  if (boton) {
    const alScroll = () => {
      boton.classList.toggle('visible', window.scrollY > 400);
    };
    alScroll();
    addEventListener('scroll', alScroll, { passive: true });
  }
</script>
