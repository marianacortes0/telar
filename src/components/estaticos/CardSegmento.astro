---
interface Props {
  titulo: string;
  gancho: string;
  descripcion: string;
  desde: string;
  href: string;
  indice?: number;
}
const { titulo, gancho, descripcion, desde, href, indice = 0 } = Astro.props;
---

<a class="card segmento" href={href} data-revelar style={`--i:${indice}`}>
  <span class="segmento-titulo">{titulo}</span>
  <span class="gancho">{gancho}</span>
  <span class="descripcion">{descripcion}</span>
  <span class="pie-card">
    <span class="precio">{desde}</span>
    <span class="flecha" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .segmento {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--color-lino);
    min-height: 100%;
    transition: border-color var(--dur-rapido) var(--ease-precision),
      transform var(--dur-rapido) var(--ease-salida);
  }
  .segmento:hover {
    border-color: var(--color-teal-luz);
    transform: translateY(-3px);
  }

  .segmento-titulo {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal-luz);
  }
  .gancho {
    font-family: var(--fuente-display);
    font-size: clamp(1.15rem, 3.5vw, 1.45rem);
    font-weight: 500;
    line-height: 1.15;
  }
  .descripcion {
    color: var(--color-humo);
    font-size: 0.92rem;
    line-height: 1.5;
    flex-grow: 1;
  }
  .pie-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }
  .pie-card .precio {
    color: var(--color-oro);
    font-size: 0.9rem;
  }
  .flecha {
    color: var(--color-oro);
    transition: transform var(--dur-rapido) var(--ease-nodo);
  }
  .segmento:hover .flecha {
    transform: translateX(4px);
  }
</style>
