---
/**
 * Telar Monitor: antes y después en una sola imagen. A la izquierda la factura
 * que sorprende (el pico del consumo late); a la derecha el tablero en tiempo
 * real (una franja de luz lo recorre y el punto que señalan late).
 */
import { Image } from 'astro:assets';
import Escena from './Escena.astro';
import foto from '../../assets/ramas/monitor-escena.jpg';
---

<Escena>
  <div class="marco">
    <Image
      src={foto}
      alt="Antes, un hombre preocupado revisa la factura de luz. Después, el mismo negocio sigue su consumo, su producción solar y sus ventas en un tablero de Telar Monitor"
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 64rem) 36rem, 92vw"
      class="foto"
    />
    <!-- Lienzo de 2000 × 1116, misma proporción que la imagen -->
    <svg class="red" viewBox="0 0 2000 1116" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="pantalla-monitor">
          <path d="M1003 150L1450 250L1440 690L1003 745Z"></path>
        </clipPath>
        <linearGradient id="franja-monitor" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0"></stop>
          <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.3"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
        </linearGradient>
      </defs>

      <!-- Antes: el pico del consumo que nadie entiende -->
      <circle class="alerta" cx="965" cy="592" r="30"></circle>
      <circle class="alerta segundo" cx="965" cy="592" r="30"></circle>

      <!-- Después: el tablero se actualiza en vivo -->
      <g clip-path="url(#pantalla-monitor)">
        <rect class="franja" x="0" y="100" width="180" height="700" fill="url(#franja-monitor)"></rect>
      </g>
      <circle class="vivo" cx="1022" cy="181" r="14"></circle>
      <circle class="dato" cx="1385" cy="372" r="46"></circle>
      <circle class="dato" cx="1213" cy="443" r="26" style="--retraso:1.3s"></circle>
    </svg>
  </div>
</Escena>

<style>
  .marco {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--color-borde);
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.45);
  }
  .foto {
    display: block;
    width: 100%;
    height: auto;
  }
  .red {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .alerta,
  .dato,
  .vivo {
    fill: none;
    stroke-width: 6;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .alerta {
    stroke: var(--color-oro);
    animation: latir-monitor 2s var(--ease-salida) infinite;
  }
  .alerta.segundo {
    animation-delay: 1s;
  }
  .dato {
    stroke: var(--color-teal-luz);
    animation: latir-monitor 2.8s var(--ease-salida) infinite;
    animation-delay: var(--retraso, 0s);
  }
  .vivo {
    stroke: #22c55e;
    animation: latir-monitor 1.8s var(--ease-salida) infinite;
  }
  @keyframes latir-monitor {
    0% {
      opacity: 0.9;
      transform: scale(0.7);
    }
    100% {
      opacity: 0;
      transform: scale(1.9);
    }
  }

  .franja {
    transform-box: view-box;
    animation: barrer-monitor 5s ease-in-out infinite;
  }
  @keyframes barrer-monitor {
    0% {
      transform: translateX(800px) skewX(-14deg);
    }
    55%,
    100% {
      transform: translateX(1520px) skewX(-14deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .alerta,
    .dato,
    .vivo,
    .franja {
      animation: none;
    }
    .franja {
      opacity: 0;
    }
  }
</style>
