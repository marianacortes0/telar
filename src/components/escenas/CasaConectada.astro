---
/**
 * Telar Casa: dos fotos de casas que se alternan con un fundido. Sobre cada una,
 * hilos que unen cada dispositivo a su panel central (Home Assistant "los junta
 * a todos"); los nodos laten y los hilos se encienden por turnos.
 */
import { Image } from 'astro:assets';
import Escena from './Escena.astro';
import foto1 from '../../assets/ramas/casa-conectada.jpg';
import foto2 from '../../assets/ramas/casa-conectada-2.jpg';

interface Punto {
  x: number;
  y: number;
}

// Coordenadas sobre cada foto, en un lienzo de 2000 × 1116 (misma proporción).
const escenas = [
  {
    foto: foto1,
    alt: 'Sala con dispositivos inteligentes conectados: panel de control en la pared, parlantes, lámpara, tablet y robot aspirador',
    centro: { x: 1665, y: 383 }, // panel de la pared
    dispositivos: [
      { x: 843, y: 438 }, // lámpara colgante
      { x: 588, y: 622 }, // tablet
      { x: 988, y: 672 }, // parlante de la mesa auxiliar
      { x: 632, y: 885 }, // robot aspirador
      { x: 1865, y: 728 }, // parlante de la derecha
    ],
  },
  {
    foto: foto2,
    alt: 'Cocina y sala conectadas: pantalla de control en el mesón, panel en la pared, enchufe inteligente, parlante, lámparas, cámara y robot aspirador',
    centro: { x: 1530, y: 518 }, // pantalla del mesón
    dispositivos: [
      { x: 812, y: 466 }, // panel de la pared
      { x: 1370, y: 548 }, // enchufe inteligente
      { x: 1652, y: 540 }, // parlante
      { x: 1462, y: 318 }, // lámpara colgante
      { x: 1935, y: 120 }, // cámara del techo
      { x: 735, y: 960 }, // robot aspirador
    ],
  },
];

/** Hilo curvo de un dispositivo al centro (se arquea hacia arriba). */
const hilo = (d: Punto, c: Punto) => {
  const cx = (d.x + c.x) / 2;
  const cy = Math.min(d.y, c.y) - 120;
  return `M${d.x} ${d.y} Q${cx} ${cy} ${c.x} ${c.y}`;
};
---

<Escena>
  <div class="marco">
    {
      escenas.map((e, n) => (
        <div class:list={['capa', { segunda: n > 0 }]}>
          <Image
            src={e.foto}
            alt={e.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 64rem) 36rem, 92vw"
            class="foto"
          />
          <svg class="red" viewBox="0 0 2000 1116" aria-hidden="true" focusable="false">
            {e.dispositivos.map((d, i) => (
              <path class="hilo" d={hilo(d, e.centro)} style={`--i:${i}`} />
            ))}
            {e.dispositivos.map((d, i) => (
              <g class="nodo" style={`--i:${i}`}>
                <circle class="pulso" cx={d.x} cy={d.y} r="38" />
                <circle class="punto" cx={d.x} cy={d.y} r="17" />
              </g>
            ))}
            <g class="nodo centro">
              <circle class="pulso" cx={e.centro.x} cy={e.centro.y} r="54" />
              <circle class="punto" cx={e.centro.x} cy={e.centro.y} r="22" />
            </g>
          </svg>
        </div>
      ))
    }
  </div>
</Escena>

<style>
  .marco {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--color-borde);
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.45);
  }
  /* Velo oscuro sutil (por foto) para que los hilos resalten */
  .capa::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-abismo) 5%, transparent),
      color-mix(in srgb, var(--color-abismo) 30%, transparent)
    );
    pointer-events: none;
  }

  /* Las dos fotos se alternan: la segunda va encima y entra y sale con un fundido */
  /* Cada foto aísla su velo y su red: los nodos de una no se ven sobre la otra */
  .capa {
    position: relative;
    isolation: isolate;
  }
  .capa.segunda {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    animation: alternar 16s ease-in-out infinite;
  }
  @keyframes alternar {
    0%,
    42% {
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .red {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .hilo {
    fill: none;
    stroke: var(--color-teal-luz);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 3 16;
    opacity: 0.35;
    animation: encender 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.6s);
  }
  .punto {
    fill: var(--color-teal-luz);
    stroke: var(--color-abismo);
    stroke-width: 4;
  }
  .centro .punto {
    fill: var(--color-oro);
  }
  .pulso {
    fill: none;
    stroke: var(--color-teal-luz);
    stroke-width: 6;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: latir 2.8s var(--ease-salida) infinite;
    animation-delay: calc(var(--i, 0) * 0.45s);
  }
  .centro .pulso {
    stroke: var(--color-oro);
    animation-duration: 2.2s;
  }

  @keyframes encender {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.95;
    }
  }
  @keyframes latir {
    0% {
      opacity: 0.9;
      transform: scale(0.5);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .capa.segunda,
    .hilo,
    .pulso {
      animation: none;
    }
    .hilo {
      opacity: 0.7;
    }
  }
</style>
