---
import TablaPrecios from './TablaPrecios.astro';
import { linkWhatsApp } from '../../lib/whatsapp';

export interface Nivel {
  nombre: string;
  para: string;
  filas: { celdas: string[]; destacado?: boolean }[];
  /** Mensaje de WhatsApp prellenado para el CTA de este nivel. */
  wa: string;
  ctaLabel?: string;
}

interface Props {
  niveles: Nivel[];
  encabezados?: [string, string];
}

const { niveles, encabezados = ['Concepto', 'Precio'] } = Astro.props;
---

<div class="niveles">
  {
    niveles.map((nivel, i) => (
      <article class="nivel card" data-revelar style={`--i:${i}`}>
        <div class="nivel-cabecera">
          <h3>{nivel.nombre}</h3>
          <p class="nivel-para">{nivel.para}</p>
        </div>
        <TablaPrecios encabezados={encabezados} filas={nivel.filas} />
        <a
          href={linkWhatsApp(nivel.wa)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-oro"
        >
          {nivel.ctaLabel ?? `Cotizar nivel ${nivel.nombre}`}
        </a>
      </article>
    ))
  }
</div>
